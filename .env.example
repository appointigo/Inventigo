# Disabled by default. Enable only temporarily in controlled staging environments.
WHATSAPP_DEBUG_DIAGNOSTICS=false
# Shared secret used by Vercel Cron and the Railway invoice worker trigger.
# CRON_SECRET=replace-with-a-long-random-value
# Railway cron services can use the web service's public URL explicitly. When
# omitted, the trigger uses Railway's injected RAILWAY_PUBLIC_DOMAIN value.
# STOCKIVA_APP_URL=https://your-stockiva-service.example.com
# Optional browser overrides for self-hosted deployments. Railway's Dockerfile
# already sets the cache directory and installs the pinned browser in the image.
# PUPPETEER_CACHE_DIR=/absolute/path/to/persistent/puppeteer-cache
# PUPPETEER_EXECUTABLE_PATH=/absolute/path/to/chrome
