# Disabled by default. Enable only temporarily in controlled staging environments.
WHATSAPP_DEBUG_DIAGNOSTICS=false
# Shared secret used by Vercel Cron and the Railway invoice worker trigger.
# CRON_SECRET=replace-with-a-long-random-value
# Railway cron services should use the web service's public URL explicitly.
# RAILWAY_PUBLIC_DOMAIN on a separate cron service may not identify the web service.
# STOCKIVA_APP_URL=https://your-stockiva-service.example.com
# Checkout waits this long for an immediate invoice result before returning the
# committed bill with a processing state. Range: 0-15000; default: 8000.
# WHATSAPP_INVOICE_INITIAL_WAIT_MS=8000
# Disabled unless both values exactly match the single authorized smoke record.
# Remove them after the one-record test succeeds.
# WHATSAPP_INVOICE_SMOKE_TEST_DELIVERY_ID=00000000-0000-0000-0000-000000000000
# WHATSAPP_INVOICE_SMOKE_TEST_RECIPIENT=919876543210
# Optional browser overrides for self-hosted deployments. Railway's Dockerfile
# already sets the cache directory and installs the pinned browser in the image.
# PUPPETEER_CACHE_DIR=/absolute/path/to/persistent/puppeteer-cache
# PUPPETEER_EXECUTABLE_PATH=/absolute/path/to/chrome
# Public marketing demo-request delivery (Resend)
RESEND_API_KEY=
# Verified Resend sending address for signup and verification emails.
# The resend.dev test sender cannot deliver to arbitrary signup addresses.
# After verifying stockiva.com for sending in Resend, use:
# AUTH_EMAIL_FROM="Stockiva <verify@stockiva.com>"
AUTH_EMAIL_FROM=
# Local development only: print signup/resend codes in the server terminal and,
# for same-origin localhost requests, in the browser console. No email is sent.
# Ignored outside NODE_ENV=development.
AUTH_VERIFICATION_CONSOLE_MODE=false
DEMO_REQUEST_RECIPIENT=
DEMO_REQUEST_SENDER=

# Stockiva SaaS billing (server only). Configure separate test/live credentials.
# Checkout stays disabled until catalog publication and webhook processing are ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test Mode checkout is disabled until plans are mapped and the draft catalog is published.
# Never enable this with live Razorpay keys; payment authorization does not grant access yet.
SUBSCRIPTION_TEST_CHECKOUT_ENABLED=false
# Enable only when inbox processing and reconciliation are operational.
SUBSCRIPTION_WEBHOOK_INTAKE_ENABLED=false
