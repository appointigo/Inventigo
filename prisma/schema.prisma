model WhatsAppAutomation {
  id                   String                        @id @default(uuid())
  organizationId       String
  storeId              String?
  templateDefinitionId String
  name                 String
  trigger              WhatsAppAutomationTrigger
  isActive             Boolean                       @default(false)
  conditions           Json
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store                Store?                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  templateDefinition   WhatsAppTemplateDefinition    @relation(fields: [templateDefinitionId], references: [id], onDelete: Restrict)
  executions           WhatsAppAutomationExecution[]

  @@index([organizationId, trigger, isActive])
  @@map("whatsapp_automations")
}

model WhatsAppAutomationExecution {
  id             String                            @id @default(uuid())
  automationId   String
  eventKey       String
  subjectType    String
  subjectId      String
  storeId        String?
  contactId      String?
  recipientPhone String?
  payload        Json
  status         WhatsAppAutomationExecutionStatus @default(QUEUED)
  skipReason     String?
  errorCode      String?
  errorMessage   String?
  attempts       Int                               @default(0)
  availableAt    DateTime                          @default(now())
  lockedAt       DateTime?
  lockToken      String?
  completedAt    DateTime?
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  automation     WhatsAppAutomation                @relation(fields: [automationId], references: [id], onDelete: Cascade)
  messages       WhatsAppMessage[]

  @@unique([automationId, eventKey])
  @@index([status, availableAt, lockedAt])
  @@index([automationId, createdAt])
  @@map("whatsapp_automation_executions")
}

