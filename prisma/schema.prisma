model WhatsAppCampaignStore {
  id         String              @id @default(uuid())
  campaignId String
  storeId    String
  senderId   String
  campaign   WhatsAppCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sender     StoreWhatsAppSender @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([campaignId, storeId])
  @@index([senderId])
  @@map("whatsapp_campaign_stores")
}

model WhatsAppCampaignRecipient {
  id                 String                          @id @default(uuid())
  campaignId         String
  contactId          String
  storeId            String?
  senderId           String?
  templateInstanceId String?
  status             WhatsAppCampaignRecipientStatus
  exclusionReason    String?
  snapshot           Json?
  jobId              String?                         @unique
  attempts           Int                             @default(0)
  maxAttempts        Int                             @default(5)
  availableAt        DateTime?
  lockedAt           DateTime?
  lockToken          String?
  lastError          String?
  finalizedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime                        @default(now())
  campaign           WhatsAppCampaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact            WhatsAppContact                 @relation(fields: [contactId], references: [id], onDelete: Restrict)
  store              Store?                          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sender             StoreWhatsAppSender?            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  templateInstance   WhatsAppTemplateInstance?       @relation(fields: [templateInstanceId], references: [id], onDelete: Restrict)
  messages           WhatsAppMessage[]

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([status, availableAt, lockedAt])
  @@map("whatsapp_campaign_recipients")
}

