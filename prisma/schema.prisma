  @@unique([organizationId, provider])
  @@index([organizationId])
  @@index([status])
  @@map("whatsapp_integrations")
}

model WhatsAppCredential {
  id             String           @id @default(uuid())
  organizationId String
  provider       WhatsAppProvider @default(META)
  ciphertext     String
  iv             String
  authTag        String
  keyVersion     Int              @default(1)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
  @@map("whatsapp_credentials")
}

model WhatsAppBusinessAccount {
  id                String                        @id @default(uuid())
  integrationId     String
  metaWabaId        String                        @unique
  businessName      String?
  status            WhatsAppBusinessAccountStatus @default(PENDING)
  timezone          String?
  currency          String?
  lastSyncedAt      DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  integration       WhatsAppIntegration           @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  phoneNumbers      WhatsAppPhoneNumber[]
  templateInstances WhatsAppTemplateInstance[]

  @@index([integrationId])
  @@index([status])
  @@map("whatsapp_business_accounts")
}

model WhatsAppPhoneNumber {
  id                    String                    @id @default(uuid())
  wabaId                String
  metaPhoneNumberId     String                    @unique
  displayPhoneNumber    String
  normalizedPhoneNumber String?
  verifiedName          String?
  qualityRating         String?
  messagingLimitTier    String?
  status                WhatsAppPhoneNumberStatus @default(PENDING)
  lastSyncedAt          DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  waba                  WhatsAppBusinessAccount   @relation(fields: [wabaId], references: [id], onDelete: Cascade)
  storeMappings         StoreWhatsAppSender[]
  messages              WhatsAppMessage[]
  conversations         WhatsAppConversation[]

  @@index([wabaId])
  @@index([status])
  @@index([normalizedPhoneNumber])
  @@map("whatsapp_phone_numbers")
}

model StoreWhatsAppSender {
  id                 String                      @id @default(uuid())
  storeId            String
  phoneNumberId      String
  purpose            WhatsAppSenderPurpose
  isDefault          Boolean                     @default(false)
  priority           Int                         @default(0)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  store              Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phoneNumber        WhatsAppPhoneNumber         @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)
  campaignStores     WhatsAppCampaignStore[]
  campaignRecipients WhatsAppCampaignRecipient[]

  @@unique([storeId, phoneNumberId, purpose])
  @@index([storeId, purpose, isActive])
  @@index([phoneNumberId])
  @@index([storeId, purpose, priority])
  @@map("store_whatsapp_senders")
}

model StoreWhatsAppProfile {
  id              String   @id @default(uuid())
  storeId         String   @unique
  displayName     String
  signature       String?
  supportPhone    String?
  defaultLanguage String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_whatsapp_profiles")
}

model WhatsAppTemplateDefinition {
  id             String                     @id @default(uuid())
  organizationId String?
  scope          WhatsAppTemplateScope
  key            String
  version        Int
  language       String
  purpose        WhatsAppTemplatePurpose
  category       WhatsAppTemplateCategory
  name           String
  header         Json?
  body           String
  footer         String?
  buttons        Json?
  variables      Json?
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instances      WhatsAppTemplateInstance[]
  campaigns      WhatsAppCampaign[]
  automations    WhatsAppAutomation[]

  @@index([scope, key, isActive])
  @@index([organizationId])
  @@index([purpose, category])
  @@map("whatsapp_template_definitions")
}

model WhatsAppTemplateInstance {
  id                 String                      @id @default(uuid())
  definitionId       String
  wabaId             String
  metaTemplateId     String?                     @unique
  metaTemplateName   String
  status             WhatsAppTemplateStatus      @default(DRAFT)
  rejectionReason    String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  definition         WhatsAppTemplateDefinition  @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  waba               WhatsAppBusinessAccount     @relation(fields: [wabaId], references: [id], onDelete: Cascade)
  messages           WhatsAppMessage[]
  campaignRecipients WhatsAppCampaignRecipient[]

  @@unique([wabaId, definitionId])
  @@index([wabaId, status])
  @@index([definitionId])
  @@map("whatsapp_template_instances")
}

model WhatsAppMessage {
  id                    String                       @id @default(uuid())
  organizationId        String
  storeId               String?
  phoneNumberId         String
  templateInstanceId    String?
  campaignRecipientId   String?
  automationExecutionId String?
  conversationId        String?
  idempotencyKey        String?                      @unique
  dispatchClaimedAt     DateTime?
  metaMessageId         String?                      @unique
  direction             WhatsAppMessageDirection
  type                  WhatsAppMessageType
  purpose               WhatsAppMessagePurpose
  fromPhone             String?
  toPhone               String?
  referenceType         String?
  referenceId           String?
  payload               Json?
  status                WhatsAppMessageStatus        @default(QUEUED)
  errorCode             String?
  errorMessage          String?
  queuedAt              DateTime?
  submittedAt           DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  readAt                DateTime?
  failedAt              DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store                 Store?                       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  phoneNumber           WhatsAppPhoneNumber          @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)
  templateInstance      WhatsAppTemplateInstance?    @relation(fields: [templateInstanceId], references: [id], onDelete: SetNull)
  campaignRecipient     WhatsAppCampaignRecipient?   @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  automationExecution   WhatsAppAutomationExecution? @relation(fields: [automationExecutionId], references: [id], onDelete: SetNull)
  conversation          WhatsAppConversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  events                WhatsAppMessageEvent[]

  @@index([organizationId, createdAt])
  @@index([storeId, createdAt])
  @@index([phoneNumberId, createdAt])
  @@index([status])
  @@index([metaMessageId])
  @@index([referenceType, referenceId])
  @@index([campaignRecipientId, createdAt])
  @@index([automationExecutionId, createdAt])
  @@index([conversationId, createdAt])
  @@map("whatsapp_messages")
}

model WhatsAppMessageEvent {
  id         String          @id @default(uuid())
  messageId  String
  eventType  String
  metaStatus String?
  payload    Json?
  occurredAt DateTime
  receivedAt DateTime        @default(now())
  message    WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, occurredAt])
  @@index([occurredAt])
  @@map("whatsapp_message_events")
}

model WhatsAppWebhookEvent {
  id                 String                          @id @default(uuid())
  organizationId     String?
  providerEventId    String?
  dedupeKey          String?                         @unique
  eventType          String?
  payload            Json
  processingStatus   WhatsAppWebhookProcessingStatus @default(RECEIVED)
  processingAttempts Int                             @default(0)
  processedAt        DateTime?
  lastError          String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  organization       Organization?                   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([processingStatus, createdAt])
  @@index([providerEventId])
  @@index([organizationId, createdAt])
  @@map("whatsapp_webhook_events")
}

model WhatsAppConversation {
  id               String                            @id @default(uuid())
  organizationId   String
  phoneNumberId    String
  contactId        String?
  storeId          String?
  externalPhone    String
  routingStatus    WhatsAppConversationRoutingStatus @default(UNRESOLVED)
  unresolvedReason String?
  status           WhatsAppConversationStatus        @default(OPEN)
  lastMessageAt    DateTime
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  organization     Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber      WhatsAppPhoneNumber               @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)
  contact          WhatsAppContact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  store            Store?                            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  messages         WhatsAppMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([phoneNumberId, externalPhone, status])
  @@index([storeId, lastMessageAt])
  @@map("whatsapp_conversations")
}

