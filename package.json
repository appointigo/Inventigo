{
  "name": "stockiva",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "whatsapp:bootstrap:test-tenant": "node --experimental-transform-types scripts/bootstrap-whatsapp-test-tenant.ts",
    "whatsapp:seed:templates": "node --experimental-transform-types scripts/seed-whatsapp-templates.ts",
    "whatsapp:invoices:worker": "node scripts/trigger-whatsapp-invoice-worker.mjs",
    "test:inventory-intelligence": "node --experimental-transform-types --test src/modules/inventory-intelligence/utils/analyticsPeriod.test.ts src/modules/inventory-intelligence/utils/metrics.test.ts src/modules/inventory-intelligence/utils/portfolioAnalytics.test.ts",
    "test:analytics": "node --experimental-transform-types --test src/modules/analytics/utils/dateRange.test.ts src/modules/analytics/utils/analyticsQuery.test.ts src/modules/analytics/utils/financialAggregation.test.ts src/modules/analytics/utils/paymentAggregation.test.ts src/modules/analytics/services/analyticsAccess.test.ts src/modules/dashboard/services/profitabilityService.test.ts",
    "test:demand-intelligence": "node --experimental-transform-types --test src/modules/demand-intelligence/utils/demandAnalytics.test.ts src/modules/demand-intelligence/utils/demandValidation.test.ts src/modules/demand-intelligence/utils/demandSecurity.test.ts",
    "test:customers": "node --experimental-transform-types --test src/modules/customers/utils/customerDateWindow.test.ts src/modules/customers/customerQueries.test.ts src/modules/customers/customerNavigation.test.ts src/modules/customers/customerPagination.test.ts src/modules/customers/customerDirectoryState.test.ts src/modules/customers/customerInvoiceAccess.test.ts src/modules/customers/customerFollowUpSchemas.test.ts src/modules/customers/customerPurchasePresentation.test.ts",
    "test:release2": "node --experimental-transform-types --test src/modules/product-intelligence/productDecisionRules.test.ts src/modules/customer-action/customerSegments.test.ts src/modules/receivables/receivableAging.test.ts",
    "test:release3": "node --experimental-transform-types --test src/modules/owner-intelligence/ownerAnalytics.test.ts",
    "test:release4": "node --experimental-transform-types --test src/modules/procurement-intelligence/procurementRules.test.ts",
    "test:release5": "node --experimental-transform-types --test src/modules/replenishment/replenishmentPolicy.test.ts",
    "test:release6": "node --experimental-transform-types --test src/modules/stock-transfers/transferPolicy.test.ts",
    "test:release7": "node --experimental-transform-types --test src/modules/finance/financeRules.test.ts src/modules/finance/financeAccess.test.ts",
    "test:release8": "node --experimental-transform-types --test src/modules/forecasting/forecastRules.test.ts src/modules/forecasting/forecastScope.test.ts",
    "test:numerical-integrity": "node --experimental-transform-types --test src/modules/analytics/metrics/metricRegistry.test.ts src/modules/analytics/utils/canonicalMetrics.test.ts src/modules/analytics/utils/numericalReconciliation.test.ts src/modules/finance/refundAccounting.test.ts",
    "test:pricing-catalog": "node --experimental-transform-types --test src/modules/marketing/pricingCatalog.test.ts",
    "e2e:prepare": "node e2e/setup/prepare.mjs",
    "test:e2e:safety": "node --test e2e/setup/environment.test.mjs",
    "test:e2e": "node e2e/setup/run.mjs",
    "test:e2e:ui": "node e2e/setup/run.mjs --ui",
    "test:e2e:headed": "node e2e/setup/run.mjs --headed",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "prisma:fix-exchanged-sales": "node prisma/scripts/fix-exchanged-sales-and-backfill-returns.js",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npx prisma migrate deploy; fi && npm run build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@puppeteer/browsers": "3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@sparticuz/chromium": "153.0.0",
    "@tanstack/react-query": "^5.91.2",
    "@types/chroma-js": "^3.1.2",
    "@vercel/blob": "^2.3.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "antd": "^6.3.3",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.9.2",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jsdom": "^29.1.1",
    "next": "16.2.0",
    "next-auth": "^5.0.0-beta.30",
    "ntcjs": "^1.1.3",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "puppeteer-core": "25.11.0",
    "react": "19.2.4",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.19.37",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.35",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "puppeteer": "25.11.0",
    "typescript": "^5"
  }
}
